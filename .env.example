# .env にコピーし、radikoプレミアムの認証情報を設定してください。
# .env は chmod 600 で保護してください。
RADIKO_MAIL='your-email@example.com'
RADIKO_PASSWORD='your-password'
# OLEDのI2Cバス番号とアドレス（通常は変更不要）
OLED_PORT=1
OLED_ADDRESS=0x3c
# mpv --audio-device=help で確認できる出力先。Bluetooth JQ-BTの例:
# MPV_AUDIO_DEVICE=pipewire/bluez_output.9D:C6:55:EC:74:D5

# Spotify Web API（再生制御用）。developer.spotify.com/dashboard でアプリを作成し、
# Client ID/Secretを取得したうえで spotify_auth_setup.py を実行してください。
# SPOTIFY_REFRESH_TOKEN は spotify_auth_setup.py が自動で書き込みます（手入力不要）。
SPOTIFY_CLIENT_ID='your-spotify-client-id'
SPOTIFY_CLIENT_SECRET='your-spotify-client-secret'
SPOTIFY_REFRESH_TOKEN=
# librespot（Spotify Connect再生デバイス本体）に付ける名前。/me/player/devices の
# 名前と一致させる必要があります（librespot起動時の --name と揃える）。
SPOTIFY_DEVICE_NAME=Vcon
